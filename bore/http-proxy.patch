@@ -0,0 +1,177 @@
+//! Proxy support for connections from the client to the bore server.
+//!
+//! The proxy is only used to reach the server. Connections to the local
+//! service that is being forwarded are always made directly.
+
+use std::fmt;
+use std::net::{IpAddr, SocketAddr};
+
+use anyhow::{anyhow, bail, Context, Result};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpStream;
+
+/// Maximum size of a proxy reply header.
+const MAX_PROXY_HEADERS: usize = 16_384;
+
+/// A proxy that connections to the bore server are routed through.
+#[derive(Debug)]
+pub struct Proxy {
+    /// Host or IP address of the proxy.
+    host: String,
+
+    /// TCP port of the proxy.
+    port: u16,
+}
+
+impl Proxy {
+    /// Parse a proxy address of the form `http://host:port`.
+    ///
+    /// The destination is resolved by the proxy rather than locally.
+    pub fn parse(url: &str) -> Result<Self> {
+        let (scheme, rest) = url
+            .split_once("://")
+            .ok_or_else(|| anyhow!("expected a proxy URL of the form http://host:port"))?;
+        if scheme != "http" {
+            bail!("unsupported proxy scheme {scheme:?}, expected 'http'");
+        }
+        if rest.contains('@') {
+            bail!("proxy authentication is not supported, drop the username and password");
+        }
+        let (host, port) = split_host_port(rest)?;
+        Ok(Self { host, port })
+    }
+
+    /// Open a TCP connection to the destination, tunneled through this proxy.
+    pub async fn connect(&self, host: &str, port: u16) -> Result<TcpStream> {
+        let mut stream = TcpStream::connect((self.host.as_str(), self.port))
+            .await
+            .with_context(|| format!("could not connect to proxy {self}"))?;
+        http_connect(&mut stream, host, port)
+            .await
+            .with_context(|| format!("proxy {self} could not reach {host}:{port}"))?;
+        Ok(stream)
+    }
+}
+
+impl fmt::Display for Proxy {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "http://{}", format_target(&self.host, self.port))
+    }
+}
+
+/// Format `host:port`, bracketing IPv6 literals.
+fn format_target(host: &str, port: u16) -> String {
+    if host.contains(':') {
+        format!("[{host}]:{port}")
+    } else {
+        format!("{host}:{port}")
+    }
+}
+
+/// Split a `host:port` string, accepting bare and bracketed IPv6 literals as
+/// well as DNS names.
+fn split_host_port(hostport: &str) -> Result<(String, u16)> {
+    if let Ok(address) = hostport.parse::<SocketAddr>() {
+        return Ok((address.ip().to_string(), address.port()));
+    }
+    // A bare IP literal with no port is ambiguous, so reject it explicitly.
+    if hostport.parse::<IpAddr>().is_ok() {
+        bail!("missing port in proxy address {hostport:?}");
+    }
+
+    let (host, port) = hostport
+        .rsplit_once(':')
+        .ok_or_else(|| anyhow!("expected host:port in proxy address {hostport:?}"))?;
+    let port = port
+        .parse()
+        .with_context(|| format!("invalid proxy port {port:?}"))?;
+    let host = host
+        .strip_prefix('[')
+        .and_then(|host| host.strip_suffix(']'))
+        .unwrap_or(host)
+        .to_owned();
+    if host.is_empty() {
+        bail!("missing host in proxy address {hostport:?}");
+    }
+    Ok((host, port))
+}
+
+/// Send an HTTP `CONNECT` request, then consume the reply.
+async fn http_connect(stream: &mut TcpStream, host: &str, port: u16) -> Result<()> {
+    let target = format_target(host, port);
+    let request = format!(
+        "CONNECT {target} HTTP/1.1\r\nHost: {target}\r\nProxy-Connection: keepalive\r\n\r\n"
+    );
+    stream.write_all(request.as_bytes()).await?;
+
+    let headers = read_headers(stream).await?;
+    let status = headers.lines().next().unwrap_or_default();
+    let code = status.split_whitespace().nth(1).unwrap_or_default();
+    if !status.starts_with("HTTP/") || code != "200" {
+        bail!("proxy refused to establish the tunnel: {status}");
+    }
+    Ok(())
+}
+
+/// Read proxy reply headers, up to and including the blank line.
+async fn read_headers(stream: &mut TcpStream) -> Result<String> {
+    let mut headers = Vec::new();
+    let mut chunk = [0u8; 4096];
+    loop {
+        let n = stream
+            .read(&mut chunk)
+            .await
+            .context("reading proxy reply")?;
+        if n == 0 {
+            bail!("proxy closed the connection before sending a reply");
+        }
+        headers.extend_from_slice(&chunk[..n]);
+        if headers.windows(4).any(|window| window == b"\r\n\r\n") {
+            break;
+        }
+        if headers.len() > MAX_PROXY_HEADERS {
+            bail!("proxy sent an oversized reply");
+        }
+    }
+    Ok(String::from_utf8_lossy(&headers).into_owned())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parse() -> Result<()> {
+        for (url, expected) in [
+            ("http://127.0.0.1:8080", "http://127.0.0.1:8080"),
+            ("http://localhost:8080", "http://localhost:8080"),
+            ("http://[::1]:8080", "http://[::1]:8080"),
+        ] {
+            assert_eq!(Proxy::parse(url)?.to_string(), expected, "parsing {url}");
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn parse_rejects_invalid_urls() {
+        for url in [
+            "127.0.0.1:8080",
+            "http://127.0.0.1",
+            "http://[::1]",
+            "http://127.0.0.1:abc",
+            "http://:8080",
+            "https://127.0.0.1:443",
+            "socks5://127.0.0.1:1080",
+            "http://alice:secret@127.0.0.1:8080",
+        ] {
+            assert!(Proxy::parse(url).is_err(), "expected error for {url}");
+        }
+    }
+
+    #[test]
+    fn formats_target() {
+        assert_eq!(format_target("127.0.0.1", 8080), "127.0.0.1:8080");
+        assert_eq!(format_target("bore.pub", 7835), "bore.pub:7835");
+        assert_eq!(format_target("::1", 8080), "[::1]:8080");
+    }
+}
